.page-scroll { height: 100vh; }
.messages-page { padding-top: calc(env(safe-area-inset-top) + 92rpx); }
.message-header { display: flex; align-items: flex-start; justify-content: space-between; }
.message-title-row { display: flex; align-items: center; gap: 12rpx; }
.message-title { color: var(--forest); font-size: 54rpx; font-weight: 900; letter-spacing: -4rpx; }
.message-total { min-width: 38rpx; height: 38rpx; padding: 0 10rpx; border-radius: 999rpx; background: var(--orange); color: #fff; font-size: 20rpx; font-weight: 900; line-height: 38rpx; text-align: center; }
.message-subtitle { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }
.message-tabs { display: flex; margin: 28rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.message-tab { position: relative; flex: 1; height: 74rpx; color: #5f6461; font-size: 25rpx; }
.message-tab.is-active { color: var(--orange); font-weight: 900; }
.message-tab.is-active::after { content: ""; position: absolute; left: 32%; right: 32%; bottom: -2rpx; height: 6rpx; border-radius: 99rpx; background: var(--orange); }
.tab-tag { position: absolute; top: 4rpx; margin-left: 4rpx; padding: 2rpx 7rpx; border-radius: 999rpx; background: #eeece7; color: #858782; font-size: 14rpx; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.summary-card { min-width: 0; display: flex; align-items: center; padding: 20rpx 14rpx; text-align: left; }
.summary-icon { flex: 0 0 52rpx; width: 52rpx; height: 52rpx; margin-right: 10rpx; border-radius: 17rpx; color: #fff; font-size: 27rpx; font-weight: 900; line-height: 52rpx; text-align: center; }
.summary-icon--red { background: linear-gradient(145deg, #ff8170, #f04535); }
.summary-icon--blue { background: linear-gradient(145deg, #6f9fff, #355ee8); }
.summary-icon--green { background: linear-gradient(145deg, #65b796, #278266); }
.summary-label, .summary-count { display: block; }
.summary-label { font-size: 19rpx; font-weight: 750; }
.summary-count { margin-top: 3rpx; color: var(--orange); font-size: 23rpx; font-weight: 900; }
.summary-arrow { margin-left: auto; color: #b1b0ac; }
.message-list { overflow: hidden; }
.message-row { position: relative; width: 100%; display: flex; align-items: center; padding: 22rpx; border-bottom: 1rpx solid var(--line); text-align: left; }
.message-row:last-child { border-bottom: 0; }
.message-avatar { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border: 5rpx solid #fff; border-radius: 50%; box-shadow: 0 7rpx 18rpx rgba(30, 55, 43, 0.13); color: #fff; font-size: 29rpx; font-weight: 900; line-height: 66rpx; text-align: center; }
.message-avatar--blue { background: #497fd5; }
.message-avatar--orange { background: #f4843e; }
.message-avatar--green { background: #39856a; }
.message-row__body { flex: 1; min-width: 0; margin-left: 16rpx; }
.message-row__top { display: flex; align-items: center; justify-content: space-between; }
.message-name { font-size: 26rpx; font-weight: 850; }
.message-time { color: #aaa9a5; font-size: 18rpx; }
.message-preview { display: block; max-width: 470rpx; margin-top: 7rpx; overflow: hidden; color: var(--muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.message-unread { position: absolute; right: 19rpx; bottom: 20rpx; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; border-radius: 999rpx; background: var(--orange); color: #fff; font-size: 17rpx; font-weight: 900; line-height: 30rpx; text-align: center; }
.system-card { display: flex; margin-top: 30rpx; padding: 28rpx; }
.system-card__icon { flex: 0 0 82rpx; width: 82rpx; height: 82rpx; border-radius: 25rpx; background: linear-gradient(145deg, #ff812f, #ff5315); color: #fff; font-size: 36rpx; font-weight: 900; line-height: 82rpx; text-align: center; }
.system-card__body { margin-left: 20rpx; }
.system-card__title, .system-card__copy, .system-card__time { display: block; }
.system-card__title { font-size: 28rpx; font-weight: 900; }
.system-card__copy { margin-top: 10rpx; color: #5e625f; font-size: 22rpx; line-height: 1.65; }
.system-card__time { margin-top: 14rpx; color: #aaa9a5; font-size: 19rpx; }
