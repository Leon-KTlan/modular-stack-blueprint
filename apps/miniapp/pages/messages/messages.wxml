<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="false">
  <view class="messages-page">
    <view class="messages-head">
      <text class="messages-title">消息</text>
    </view>

    <view class="entry-row">
      <button
        wx:for="{{entries}}"
        wx:key="label"
        class="entry"
        hover-class="entry--pressed"
        hover-stay-time="80"
        bindtap="showDemoNotice"
      >
        <view class="entry-tile entry-tile--{{item.tone}}">
          <view class="entry-icon entry-icon--{{item.tone}}"></view>
          <view wx:if="{{item.count > 0}}" class="entry-badge">{{item.count}}</view>
        </view>
        <text class="entry-label">{{item.label}}</text>
      </button>
    </view>

    <view class="dm-card">
      <view
        wx:for="{{conversations}}"
        wx:key="id"
        class="dm-row {{item.unread > 0 ? 'dm-row--unread' : ''}}"
        role="button"
        hover-class="dm-row--pressed"
        hover-stay-time="80"
        bindtap="showDemoNotice"
      >
        <view class="dm-avatar dm-avatar--{{item.tone}}">{{item.avatarText}}</view>
        <view class="dm-main">
          <view class="dm-top">
            <text class="dm-name">{{item.name}}</text>
            <text wx:if="{{item.tag}}" class="dm-tag">{{item.tag}}</text>
            <text class="dm-time">{{item.time}}</text>
          </view>
          <text class="dm-preview">{{item.preview}}</text>
        </view>
        <view wx:if="{{item.unread > 0}}" class="dm-unread">{{item.unread}}</view>
      </view>
    </view>

    <text class="dm-end">没有更多会话了</text>
  </view>
</scroll-view>
