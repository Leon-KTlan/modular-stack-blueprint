PORT=3000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
MINIAPP_JWT_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
DATABASE_URL=postgresql://cangqiong:replace-with-a-long-random-secret@127.0.0.1:5432/cangqiong
WECHAT_MINIAPP_APP_ID=replace-with-miniapp-appid
WECHAT_MINIAPP_APP_SECRET=replace-with-miniapp-appsecret
# 非生产黑客松演示专用；默认关闭。用户 ID 必须对应已启用且已加入可用圈子的 miniapp_users 记录。
MOBILE_DEMO_AUTH_ENABLED=false
MOBILE_DEMO_USER_ID=

# Treehole server: a blank AI provider configuration leaves content pending for human review.
# Exact OpenAI-compatible chat/completions endpoint, model and key supplied by the operator.
TREEHOLE_AI_CHAT_COMPLETIONS_URL=
TREEHOLE_AI_MODEL=
TREEHOLE_AI_API_KEY=
# Required positive daily request cap (Shanghai day); retries also consume a reservation.
TREEHOLE_AI_DAILY_REQUEST_LIMIT=
TREEHOLE_AI_TIMEOUT_MS=15000
TREEHOLE_AI_MAX_OUTPUT_TOKENS=1000
# Only enable rule auto-publication with an explicitly reviewed/versioned literal risk lexicon.
# Risk phrases are separated by |. Empty configuration routes everything to AI/human pending.
TREEHOLE_RULE_VERSION=
TREEHOLE_RISK_PATTERNS=
# Optional 0..1 sample fraction of rule-approved submissions; unset disables sampling.
TREEHOLE_SAMPLE_RATE=
