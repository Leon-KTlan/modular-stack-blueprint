.connections-scroll { height: 100vh; background: #fffaf2; }
.connections-page { position: relative; min-height: 100vh; overflow: hidden; padding: calc(env(safe-area-inset-top) + 14rpx) 30rpx calc(50rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, #f6faef 0, #fffaf2 480rpx, #fff8ee 100%); }
.connections-scene { position: absolute; left: 0; right: 0; top: 80rpx; height: 360rpx; overflow: hidden; opacity: .55; }
.connections-road { position: absolute; left: -160rpx; top: 40rpx; width: 890rpx; height: 210rpx; border: 18rpx solid #d8e6d2; border-radius: 50%; transform: rotate(-13deg); }
.connections-tree { position: absolute; right: 95rpx; top: 90rpx; width: 64rpx; height: 105rpx; border-radius: 50% 50% 35% 35%; background: #bed7b9; box-shadow: 0 72rpx 0 -24rpx #9fc09f, -420rpx 35rpx 0 -6rpx #c8dec4; }
.connections-navbar { position: relative; z-index: 1; display: grid; grid-template-columns: 80rpx 1fr 80rpx; align-items: center; height: 82rpx; }
.back-button { color: #0f4d3c; font-size: 66rpx; font-weight: 300; line-height: 74rpx; text-align: left; }
.connections-title { color: #0d4e3b; font-size: 36rpx; font-weight: 900; text-align: center; }
.connections-intro { position: relative; z-index: 1; height: 260rpx; padding: 65rpx 14rpx 0; }
.connections-kicker { color: #76957e; font-size: 21rpx; font-weight: 700; letter-spacing: 4rpx; }
.connections-headline { display: block; margin-top: 24rpx; color: #084a37; font-size: 42rpx; font-weight: 900; letter-spacing: -2rpx; }
.connections-subtitle { display: block; margin-top: 16rpx; color: #707671; font-size: 23rpx; }
.connection-tabs { position: relative; z-index: 1; display: flex; padding: 8rpx; border: 1rpx solid rgba(23,76,59,.08); border-radius: 28rpx; background: rgba(255,253,247,.94); box-shadow: 0 14rpx 36rpx rgba(65,56,42,.08); }
.connection-tab { position: relative; flex: 1; height: 76rpx; border-radius: 22rpx; color: #8a908c; font-size: 27rpx; font-weight: 800; }
.connection-tab--active { background: #0a5b43; color: #fff; box-shadow: 0 10rpx 24rpx rgba(10,91,67,.2); }
.demo-label { position: relative; z-index: 1; display: block; margin: 22rpx 8rpx 10rpx; color: #9a9d98; font-size: 20rpx; }
.connection-list { position: relative; z-index: 1; display: flex; width: 100%; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.demo-label + .connection-list { margin-top: 0; }
.connection-card { display: flex; box-sizing: border-box; width: 100%; min-height: 142rpx; align-items: center; padding: 20rpx 22rpx; border: 1rpx solid rgba(23,76,59,.07); border-radius: 27rpx; background: rgba(255,253,247,.97); box-shadow: 0 12rpx 30rpx rgba(65,56,42,.07); text-align: left; }
.connection-avatar { box-sizing: border-box; flex: 0 0 92rpx; width: 92rpx; height: 92rpx; border: 5rpx solid #ffe1a0; border-radius: 50%; background: #ffdb83; }
.connection-avatar--fallback { color: #164d3c; font-size: 38rpx; font-weight: 900; line-height: 82rpx; text-align: center; }
.connection-copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.connection-name { display: block; max-width: 430rpx; overflow: hidden; color: #0c4f3b; font-size: 28rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.connection-bio { display: -webkit-box; max-width: 430rpx; margin-top: 7rpx; overflow: hidden; color: #565e59; font-size: 21rpx; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.connection-id { display: block; margin-top: 7rpx; color: #a0a39f; font-size: 18rpx; }
.connection-arrow { flex: 0 0 28rpx; color: #9ca09c; font-size: 40rpx; text-align: right; }
.connections-empty { position: relative; z-index: 1; display: flex; min-height: 420rpx; flex-direction: column; align-items: center; justify-content: center; color: #9da09c; }
.connections-empty__icon { color: #ff9060; font-size: 58rpx; }
.connections-empty__title { margin-top: 16rpx; color: #4e5853; font-size: 28rpx; font-weight: 800; }
.connections-empty__copy { margin-top: 9rpx; font-size: 21rpx; }
