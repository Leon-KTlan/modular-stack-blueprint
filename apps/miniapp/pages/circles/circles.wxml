<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="false">
  <view class="page-shell circles-page">
    <view class="page-title-row">
      <view>
        <text class="page-title">圈子<text class="title-spark">!</text></text>
        <text class="page-subtitle">找到同频的人，一起把校园生活玩得更精彩</text>
      </view>
      <button class="circle-search" bindtap="showBuilding">⌕</button>
    </view>

    <view class="circle-hero">
      <view class="circle-hero__sun">☀</view>
      <text class="circle-hero__title">好朋友\n从一个圈子开始</text>
      <text class="circle-hero__stroke">〰 〰 〰</text>
      <view class="circle-hero__campus"></view>
    </view>

    <scroll-view class="filter-scroll" scroll-x show-scrollbar="false">
      <view class="filter-row">
        <view
          wx:for="{{filters}}"
          wx:key="*this"
          data-filter="{{item}}"
          bindtap="setFilter"
          class="filter-pill {{activeFilter === item ? 'is-active' : ''}}"
          hover-class="filter-pill--pressed"
        >{{item}}</view>
      </view>
    </scroll-view>

    <view class="section-heading">
      <text class="section-heading__title">我加入的圈子</text>
      <text class="demo-chip">演示数据</text>
    </view>
    <scroll-view class="joined-scroll" scroll-x show-scrollbar="false">
      <view class="joined-row">
        <view wx:for="{{circles}}" wx:key="id" wx:if="{{item.joined}}" class="joined-circle">
          <view class="circle-icon circle-icon--{{item.tone}}">{{item.icon}}</view>
          <text class="joined-circle__name">{{item.name}}</text>
          <text class="joined-circle__count">{{item.memberCount}}人</text>
        </view>
      </view>
    </scroll-view>

    <view class="section-heading">
      <text class="section-heading__title">发现更多圈子</text>
      <text class="section-heading__link">{{activeFilter}}</text>
    </view>
    <view class="circle-list">
      <view wx:for="{{circles}}" wx:key="id" class="circle-row surface-card">
        <view class="circle-art circle-art--{{item.tone}}">
          <text>{{item.icon}}</text>
          <view class="circle-art__dot"></view>
        </view>
        <view class="circle-row__body">
          <view class="circle-row__title-line">
            <text class="circle-row__title">{{item.name}}</text>
            <text wx:if="{{item.name === '运动搭子'}}" class="new-tag">新增方向</text>
          </view>
          <text class="circle-row__description">{{item.description}}</text>
          <text class="circle-row__count">{{item.memberCount}} 人关注 · 数据待接入</text>
        </view>
        <button
          data-id="{{item.id}}"
          bindtap="toggleJoin"
          class="join-button {{item.joined ? 'is-joined' : ''}}"
        >{{item.joined ? '已加入' : '加入'}}</button>
      </view>
    </view>
  </view>
</scroll-view>
