.tabbar {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(116rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 6rpx 18rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(23, 76, 59, .08);
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 254, 250, .98);
  box-shadow: 0 -14rpx 42rpx rgba(49, 42, 34, .11);
}

.tabbar__item {
  position: relative;
  width: 20%;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7e8380;
}

.tabbar__icon-wrap {
  position: relative;
  width: 46rpx;
  height: 43rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar__icon {
  position: relative;
  width: 39rpx;
  height: 39rpx;
  color: currentColor;
}

.tabbar__icon--home::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 1rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-radius: 4rpx 0 0 0;
  transform: rotate(45deg);
}

.tabbar__icon--home::after {
  content: "";
  position: absolute;
  left: 7rpx;
  bottom: 2rpx;
  width: 25rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 6rpx 6rpx;
}

.tabbar__icon--circles::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 0;
  width: 11rpx;
  height: 11rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-shadow: -13rpx 8rpx 0 -2rpx #fffefa, -13rpx 8rpx 0 1rpx currentColor, 13rpx 8rpx 0 -2rpx #fffefa, 13rpx 8rpx 0 1rpx currentColor;
}

.tabbar__icon--circles::after {
  content: "";
  position: absolute;
  left: 5rpx;
  bottom: 2rpx;
  width: 27rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom: 0;
}

.tabbar__icon--publish::before,
.tabbar__icon--publish::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.tabbar__icon--publish::after { transform: translate(-50%, -50%) rotate(90deg); }

.tabbar__icon--message::before {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 4rpx;
  width: 31rpx;
  height: 25rpx;
  border: 4rpx solid currentColor;
  border-radius: 13rpx;
}

.tabbar__icon--message::after {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 29rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 4rpx solid currentColor;
  transform: skew(-28deg);
}

.tabbar__icon--profile::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 0;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tabbar__icon--profile::after {
  content: "";
  position: absolute;
  left: 5rpx;
  bottom: 0;
  width: 28rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
}

.tabbar__text {
  margin-top: 7rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.tabbar__item.is-active { color: #ff641e; }

.tabbar__item.is-raised .tabbar__icon-wrap {
  width: 78rpx;
  height: 78rpx;
  margin-top: -45rpx;
  border: 8rpx solid #fffefa;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff792b, #ff5417);
  box-shadow: 0 14rpx 28rpx rgba(255, 100, 30, .27);
  color: #fff;
}

.tabbar__item.is-raised .tabbar__text { margin-top: 2rpx; }

.tabbar__badge {
  position: absolute;
  top: -9rpx;
  right: -17rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 4rpx solid #fffefa;
  border-radius: 999rpx;
  background: #ff4d36;
  color: #fff;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}
