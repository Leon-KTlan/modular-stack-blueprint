<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="false">
  <view class="profile-page">
    <view class="campus-scene" aria-hidden="true">
      <view class="scene-road scene-road--one"></view>
      <view class="scene-road scene-road--two"></view>
      <view class="scene-building"></view>
      <view class="scene-tower"></view>
      <view class="scene-tree scene-tree--one"></view>
      <view class="scene-tree scene-tree--two"></view>
    </view>

    <view class="passport">
      <view class="passport-rail">
        <text class="passport-rail__en">CAMPUS\nPASS</text>
        <view class="passport-rail__line"></view>
        <view class="passport-rail__slot"></view>
        <view class="passport-rail__campus"></view>
      </view>

      <view class="passport-card">
        <view class="passport-corner"></view>
        <view class="passport-stamp">校</view>
        <button class="edit-profile" bindtap="openEditor">编辑主页</button>
        <view class="passport-content">
          <view class="profile-avatar-wrap">
            <image wx:if="{{profile.avatarUrl}}" class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
            <image wx:else class="profile-avatar" src="/assets/profile-avatar.png" mode="aspectFill"></image>
          </view>
          <view class="profile-copy">
            <view class="profile-heading">
              <view class="profile-name-wrap">
                <text class="profile-name">{{profile.nickname}}</text>
                <text wx:if="{{genderSymbol}}" class="gender-symbol gender-symbol--{{profile.gender}}">{{genderSymbol}}</text>
              </view>
            </view>
            <view class="identity-tag"><view class="identity-tag__leaf"></view><text>同频探索者</text></view>
            <text class="profile-id">用户 ID：{{profile.id}}</text>
            <text class="profile-bio">{{profile.bio || '把喜欢的玩法写进主页，下次一起出去耍。'}}</text>
          </view>
        </view>
        <view class="profile-stats">
          <button class="profile-stat" data-tab="following" bindtap="openConnections">
            <text class="profile-stat__value">{{profile.stats.followingCount}}</text>
            <text class="profile-stat__label">关注</text>
          </button>
          <button class="profile-stat" data-tab="followers" bindtap="openConnections">
            <text class="profile-stat__value">{{profile.stats.followerCount}}</text>
            <text class="profile-stat__label">粉丝</text>
          </button>
          <view class="profile-stat">
            <text class="profile-stat__value">{{profile.stats.receivedLikeCount}}</text>
            <text class="profile-stat__label">获赞</text>
          </view>
        </view>
      </view>
    </view>


    <view class="content-tabs">
      <button wx:for="{{tabs}}" wx:key="id" class="content-tab {{activeTab === item.id ? 'content-tab--active' : ''}}" data-tab="{{item.id}}" bindtap="selectTab">
        <text>{{item.label}}</text>
        <view wx:if="{{activeTab === item.id}}" class="content-tab__indicator"></view>
      </button>
    </view>

    <view wx:if="{{visiblePosts.length}}" class="post-grid">
      <button wx:for="{{visiblePosts}}" wx:key="id" class="post-tile" data-id="{{item.id}}" bindtap="openPost">
        <view class="tile-cover">
          <image class="tile-cover__sprite tile-cover__sprite--{{item.profileCover}}" src="/assets/campus-post-sprite.jpg" mode="scaleToFill"></image>
        </view>
        <text class="tile-title">{{item.profileTitle}}</text>
        <view class="tile-meta">
          <view class="tile-meta__group">
            <view class="eye-icon"><view class="eye-icon__pupil"></view></view>
            <text>{{item.viewCount}}</text>
          </view>
          <view class="tile-meta__group">
            <text class="like-icon">♡</text>
            <text>{{item.likeCount}}</text>
          </view>
        </view>
      </button>
    </view>
    <view wx:else class="empty-space">
      <text class="empty-space__icon">◇</text>
      <text class="empty-space__title">这里还没有内容</text>
      <text class="empty-space__copy">去校园里发现一点新鲜事吧</text>
    </view>
  </view>
</scroll-view>
