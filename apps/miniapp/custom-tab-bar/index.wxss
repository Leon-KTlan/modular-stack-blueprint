.tabbar {
  position: fixed;
  z-index: 100;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 12rpx;
  border: 1rpx solid rgba(23, 76, 59, 0.1);
  border-radius: 36rpx;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: 0 18rpx 48rpx rgba(48, 39, 28, 0.16);
}

.tabbar__item {
  position: relative;
  width: 116rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #777b78;
}

.tabbar__icon-wrap {
  position: relative;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar__icon {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.tabbar__text {
  margin-top: 7rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.tabbar__item.is-active {
  color: #ff641e;
}

.tabbar__item.is-raised .tabbar__icon-wrap {
  width: 74rpx;
  height: 74rpx;
  margin-top: -48rpx;
  border: 8rpx solid #fffdf8;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7627, #ff5315);
  box-shadow: 0 14rpx 28rpx rgba(255, 100, 30, 0.25);
  color: #fff;
}

.tabbar__item.is-raised .tabbar__text {
  margin-top: 3rpx;
}

.tabbar__badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 4rpx solid #fffdf8;
  border-radius: 999rpx;
  background: #ff4d36;
  color: #fff;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}
