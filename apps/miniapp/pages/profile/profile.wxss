.page-scroll { height: 100vh; }
.profile-page { padding-top: calc(env(safe-area-inset-top) + 92rpx); }
.profile-topbar { display: flex; align-items: center; justify-content: space-between; }
.settings-button { width: 72rpx; height: 72rpx; border: 1rpx solid var(--line); border-radius: 50%; background: #fff; color: #5d635f; font-size: 31rpx; line-height: 70rpx; }
.identity-card { position: relative; display: flex; align-items: center; overflow: hidden; margin-top: 30rpx; padding: 34rpx 30rpx; border-radius: 34rpx; background: linear-gradient(135deg, #174c3b, #256c54); box-shadow: 0 20rpx 46rpx rgba(23, 76, 59, 0.22); color: #fff; }
.identity-card__shape { position: absolute; right: -50rpx; top: -80rpx; width: 260rpx; height: 260rpx; border: 46rpx solid rgba(255, 213, 120, 0.18); border-radius: 50%; }
.profile-avatar { position: relative; z-index: 2; flex: 0 0 120rpx; width: 120rpx; height: 120rpx; border: 8rpx solid rgba(255, 255, 255, 0.28); border-radius: 38rpx; background: linear-gradient(145deg, #ff9847, #ff5d20); color: #fff; font-size: 44rpx; font-weight: 900; line-height: 104rpx; text-align: center; transform: rotate(-3deg); }
.profile-copy { position: relative; z-index: 2; flex: 1; min-width: 0; margin-left: 24rpx; }
.profile-name-row { display: flex; align-items: center; gap: 12rpx; }
.profile-name { font-size: 35rpx; font-weight: 900; }
.demo-chip--light { border-color: rgba(255, 255, 255, 0.34); background: rgba(255, 255, 255, 0.14); color: #fff; }
.profile-id, .profile-bio { display: block; }
.profile-id { margin-top: 8rpx; font-size: 19rpx; opacity: 0.72; }
.profile-bio { margin-top: 14rpx; font-size: 21rpx; line-height: 1.5; opacity: 0.92; }
.stats-card { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18rpx; padding: 24rpx 12rpx; }
.stat-item { position: relative; text-align: center; }
.stat-item + .stat-item::before { content: ""; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 1rpx; background: var(--line); }
.stat-value, .stat-label { display: block; }
.stat-value { color: var(--forest); font-size: 34rpx; font-weight: 900; }
.stat-label { margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }
.profile-note { display: flex; align-items: flex-start; margin-top: 18rpx; padding: 19rpx 22rpx; border-radius: 20rpx; background: #eef6f0; color: #4f665b; font-size: 20rpx; line-height: 1.55; }
.profile-note__icon { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; margin: 1rpx 12rpx 0 0; border-radius: 50%; background: #5a8a71; color: #fff; font-size: 18rpx; font-weight: 900; line-height: 30rpx; text-align: center; }
.profile-menu { overflow: hidden; }
.menu-row { width: 100%; display: flex; align-items: center; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line); text-align: left; }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; border-radius: 18rpx; background: var(--orange-soft); color: var(--orange); font-size: 27rpx; font-weight: 900; line-height: 58rpx; text-align: center; }
.menu-copy { flex: 1; margin-left: 17rpx; }
.menu-title, .menu-caption { display: block; }
.menu-title { font-size: 25rpx; font-weight: 800; }
.menu-caption { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }
.menu-arrow { color: #b2b0aa; font-size: 34rpx; }
.version-copy { display: block; margin: 30rpx 0 12rpx; color: #aaa9a5; font-size: 18rpx; text-align: center; }
