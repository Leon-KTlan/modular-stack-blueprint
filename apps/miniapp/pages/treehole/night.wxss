page{background:#182329;color:#e9e4d5}button:not([size="mini"]){width:auto;margin:0;padding:0;border:0;background:transparent;color:inherit;font-size:inherit;font-weight:400;line-height:inherit;box-sizing:border-box}button::after{border:0}button.enter-button{display:flex;width:100%;box-sizing:border-box;align-items:center;justify-content:center;gap:40rpx;min-height:100rpx;padding:20rpx 24rpx;border-radius:15rpx;background:#ecd49b;color:#222e31;font-size:27rpx;letter-spacing:3rpx}button.enter-button[disabled]{background:#766f57;color:#222e31}button.enter-button.secondary{margin-top:14rpx;background:transparent;border:1rpx solid #36454b;color:#e9e4d5}.overlay{position:fixed;z-index:500;top:0;right:0;bottom:0;left:0;width:100%;height:100%;background:rgba(7,20,22,.7)}.sheet-stage{display:flex;flex-direction:column;justify-content:flex-end;min-height:100vh;padding-top:12vh;box-sizing:border-box}.sheet{width:100%;flex:none;padding:25rpx 46rpx calc(46rpx + env(safe-area-inset-bottom));border-radius:56rpx 56rpx 0 0;background:#182329}.sheet::before{content:"";display:block;width:64rpx;height:7rpx;margin:0 auto 30rpx;border-radius:8rpx;background:#36454b}.sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx;gap:20rpx}.sheet-title{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:43rpx;line-height:1.4;flex:1;min-width:0}.sheet-head button{display:flex;flex:none;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:50%;background:#354443;color:#a2b2b4;font-size:42rpx}.muted{color:#a2b2b4}.icon{width:30rpx;height:30rpx;flex:none}.footnote{display:block;word-break:break-all;margin:24rpx 0;color:#a2b2b4;font-size:20rpx;line-height:1.8}.error{display:block;color:#eccd8b;font-size:24rpx;line-height:1.7;margin:18rpx 0;white-space:pre-wrap;word-break:break-all}.plain-input{display:block;width:100%;height:300rpx;padding:30rpx;border:1rpx solid #36454b;border-radius:22rpx;background:#202f36;color:#e9e4d5;font-size:28rpx;line-height:1.9}.placeholder{color:#829699}
