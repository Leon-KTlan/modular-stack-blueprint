@import "../treehole/night.wxss";
.night-scroll{height:100vh;background:#182329}.landing{min-height:100vh;padding:0 46rpx calc(180rpx + env(safe-area-inset-bottom));text-align:center}.eyebrow{display:block;color:#a2b2b4;font-size:17rpx;letter-spacing:4rpx}.title{display:block;margin-top:27rpx;font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:58rpx;font-weight:400;line-height:1.45;white-space:pre-line;color:#e9e4d5}.lead{display:block;margin-top:22rpx;color:#a2b2b4;font-size:24rpx;line-height:1.9;white-space:pre-line}.portal-stage{position:relative;height:500rpx;margin:8rpx -20rpx 0}button.portal-button{position:absolute;width:310rpx;height:430rpx;left:50%;top:16rpx;transform:translateX(-50%)}.portal-art{width:100%;height:100%}.slogan{position:absolute;font-size:19rpx;letter-spacing:2rpx;color:#a2b2b4}.slogan-one{left:0;top:100rpx;transform:rotate(-9deg)}.slogan-two{right:0;top:210rpx;transform:rotate(8deg)}.slogan-three{left:50%;bottom:10rpx;transform:translateX(-50%);white-space:nowrap}.landing-foot{display:flex;justify-content:center;gap:26rpx;margin-top:26rpx;color:#a2b2b4;font-size:19rpx}button.quiet-link{margin:12rpx auto 0;min-height:80rpx;color:#a2b2b4;font-size:21rpx}.rule-copy{display:block;white-space:pre-line;font-size:25rpx;line-height:1.8;color:#a2b2b4;margin-bottom:30rpx}
