<view wx:if="{{!hidden}}" class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar__item {{selected === index ? 'is-active' : ''}} {{item.raised ? 'is-raised' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tabbar__icon-wrap">
      <view class="tabbar__icon tabbar__icon--{{item.icon}}"></view>
      <text wx:if="{{item.text === '消息' && unread > 0}}" class="tabbar__badge">{{unread}}</text>
    </view>
    <text class="tabbar__text">{{item.text}}</text>
  </view>
</view>
