.page-scroll { height: 100vh; }
.detail-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 92rpx) 26rpx calc(132rpx + env(safe-area-inset-bottom)); background: var(--cream); }
.detail-nav { display: flex; align-items: center; justify-content: space-between; height: 76rpx; }
.back-button { width: 64rpx; height: 64rpx; border: 1rpx solid var(--line); border-radius: 50%; background: #fff; color: var(--forest); font-size: 48rpx; line-height: 56rpx; }
.detail-nav__title { margin-left: 36rpx; font-size: 29rpx; font-weight: 900; }
.detail-post { margin-top: 18rpx; padding: 27rpx; }
.author-row { display: flex; align-items: center; }
.detail-avatar { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: 50%; color: #fff; font-size: 29rpx; font-weight: 900; line-height: 76rpx; text-align: center; }
.detail-avatar--library { background: linear-gradient(145deg, #428f6b, #174c3b); }
.detail-avatar--sunset { background: linear-gradient(145deg, #ff9d4f, #ec5724); }
.author-copy { flex: 1; margin-left: 15rpx; }
.author-name, .author-meta { display: block; }
.author-name { font-size: 27rpx; font-weight: 900; }
.author-meta { margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }
.detail-follow { padding: 10rpx 22rpx; border-radius: 999rpx; background: var(--orange-soft); color: var(--orange); font-size: 21rpx; font-weight: 800; }
.detail-content { display: block; margin: 26rpx 0 21rpx; font-size: 29rpx; line-height: 1.72; }
.detail-cover { position: relative; height: 450rpx; overflow: hidden; border-radius: 26rpx; background: linear-gradient(#8fd2f7 0 56%, #b3d282 56% 100%); }
.detail-cover--sunset { background: linear-gradient(#f3a15c 0, #ffd6a0 52%, #587d5e 53%); }
.detail-cover__sun { position: absolute; right: 58rpx; top: 55rpx; width: 76rpx; height: 76rpx; border-radius: 50%; background: #ffe873; box-shadow: 0 0 42rpx rgba(255, 244, 163, 0.9); }
.detail-cover__building { position: absolute; left: 0; right: 0; bottom: 74rpx; height: 140rpx; background: #f6e3be; border-top: 19rpx solid #fff7df; box-shadow: inset 0 -32rpx rgba(122, 88, 58, 0.12); }
.detail-cover__tree { position: absolute; left: 52rpx; bottom: 68rpx; width: 106rpx; height: 206rpx; border-radius: 50% 52% 36% 36%; background: #347047; box-shadow: 70rpx 30rpx 0 #4d8c5b; }
.detail-cover__caption { position: absolute; left: 20rpx; bottom: 18rpx; padding: 8rpx 15rpx; border-radius: 999rpx; background: rgba(25, 43, 34, 0.74); color: #fff; font-size: 18rpx; }
.detail-actions { display: flex; justify-content: space-around; margin-top: 24rpx; }
.detail-action { color: #626863; font-size: 24rpx; }
.detail-action.is-liked { color: var(--orange); }
.comment-heading { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 6rpx 17rpx; font-size: 30rpx; font-weight: 900; }
.comment-heading__count { color: var(--muted); font-size: 20rpx; font-weight: 400; }
.comment-list { overflow: hidden; }
.comment-row { display: flex; padding: 24rpx; border-bottom: 1rpx solid var(--line); }
.comment-row:last-child { border-bottom: 0; }
.comment-avatar { flex: 0 0 62rpx; width: 62rpx; height: 62rpx; border-radius: 50%; background: var(--forest); color: #fff; font-size: 23rpx; font-weight: 900; line-height: 62rpx; text-align: center; }
.comment-body { flex: 1; margin-left: 15rpx; }
.comment-top { display: flex; justify-content: space-between; }
.comment-name { font-size: 23rpx; font-weight: 800; }
.comment-time { color: #aaa9a5; font-size: 18rpx; }
.comment-content { display: block; margin-top: 9rpx; color: #4d524f; font-size: 23rpx; line-height: 1.55; }
.comment-composer { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 14rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255, 253, 249, 0.98); }
.comment-placeholder { flex: 1; height: 72rpx; padding: 0 24rpx; border-radius: 999rpx; background: #f1efea; color: #999a96; font-size: 21rpx; line-height: 72rpx; text-align: left; }
.comment-send { width: 108rpx; height: 72rpx; border-radius: 999rpx; background: var(--orange); color: #fff; font-size: 22rpx; font-weight: 800; line-height: 72rpx; }
