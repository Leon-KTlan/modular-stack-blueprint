.page-scroll {
  height: 100vh;
  background: #faf7ef;
}

.messages-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 128rpx) 32rpx calc(180rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0%, rgba(255, 185, 121, 0.18), transparent 34%),
    radial-gradient(circle at 0% 100%, rgba(211, 229, 201, 0.28), transparent 32%),
    #faf7ef;
}

.messages-head {
  padding: 0 4rpx;
}

.messages-title {
  color: #1d211f;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

/* 入口：糖果瓷面 */
.entry-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 56rpx;
  margin-top: 44rpx;
}

.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.12s ease;
}

.entry--pressed {
  transform: scale(0.94);
}

.entry-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 42rpx;
}

.entry-tile--red {
  border: 2rpx solid rgba(255, 90, 60, 0.18);
  background: linear-gradient(165deg, #fff4ef 0%, #ffe3da 100%);
  box-shadow: 0 16rpx 36rpx rgba(255, 90, 60, 0.13);
}

.entry-tile--blue {
  border: 2rpx solid rgba(47, 134, 184, 0.18);
  background: linear-gradient(165deg, #eff7fe 0%, #dcedfa 100%);
  box-shadow: 0 16rpx 36rpx rgba(47, 134, 184, 0.12);
}

.entry-tile--green {
  border: 2rpx solid rgba(28, 122, 88, 0.16);
  background: linear-gradient(165deg, #ecf6f0 0%, #dcefe4 100%);
  box-shadow: 0 16rpx 36rpx rgba(28, 122, 88, 0.12);
}

.entry-icon {
  width: 54rpx;
  height: 54rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}

.entry-icon--red {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M19%2014c1.49-1.46%203-3.21%203-5.5A5.5%205.5%200%200%200%2016.5%203c-1.76%200-3%20.5-4.5%202-1.5-1.5-2.74-2-4.5-2A5.5%205.5%200%200%200%202%208.5c0%202.3%201.5%204.05%203%205.5l7%207Z'%20fill='%23FF5A3C'%20fill-opacity='.16'/%3E%3Cpath%20d='M19%2014c1.49-1.46%203-3.21%203-5.5A5.5%205.5%200%200%200%2016.5%203c-1.76%200-3%20.5-4.5%202-1.5-1.5-2.74-2-4.5-2A5.5%205.5%200%200%200%202%208.5c0%202.3%201.5%204.05%203%205.5l7%207Z'%20fill='none'%20stroke='%23FF5A3C'%20stroke-width='2.1'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E");
}

.entry-icon--blue {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M7.9%2020A9%209%200%201%200%204%2016.1L2%2022Z'%20fill='%232F86B8'%20fill-opacity='.16'/%3E%3Cpath%20d='M7.9%2020A9%209%200%201%200%204%2016.1L2%2022Z'%20fill='none'%20stroke='%232F86B8'%20stroke-width='2.1'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E");
}

.entry-icon--green {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M6%208a6%206%200%200%201%2012%200c0%207%203%209%203%209H3s3-2%203-9'%20fill='%231C7A58'%20fill-opacity='.16'/%3E%3Cg%20fill='none'%20stroke='%231C7A58'%20stroke-width='2.1'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M6%208a6%206%200%200%201%2012%200c0%207%203%209%203%209H3s3-2%203-9'/%3E%3Cpath%20d='M10.3%2021a1.94%201.94%200%200%200%203.4%200'/%3E%3Cpath%20d='M2%208.8a9%209%200%200%201%203-6.3'/%3E%3Cpath%20d='M22%208.8a9%209%200%200%200-3-6.3'/%3E%3C/g%3E%3C/svg%3E");
}

.entry-badge {
  position: absolute;
  top: -14rpx;
  right: -16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 6rpx 14rpx rgba(40, 35, 30, 0.14);
}

.entry-tile--red .entry-badge { background: #ff5a3c; }
.entry-tile--blue .entry-badge { background: #2f86b8; }
.entry-tile--green .entry-badge { background: #1c7a58; }

.entry-label {
  margin-top: 18rpx;
  color: #4c5550;
  font-size: 26rpx;
  font-weight: 700;
}

/* 私信会话列表 */
.dm-card {
  overflow: hidden;
  margin-top: 52rpx;
  border: 1rpx solid rgba(23, 76, 59, 0.07);
  border-radius: 32rpx;
  background: #fffdf6;
  box-shadow: 0 20rpx 44rpx rgba(67, 57, 42, 0.08);
}

.dm-row {
  position: relative;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  padding: 26rpx 28rpx;
  text-align: left;
}

.dm-row + .dm-row {
  border-top: 1rpx solid rgba(23, 76, 59, 0.06);
}

.dm-row--pressed {
  background: rgba(23, 76, 59, 0.04);
}

.dm-avatar {
  display: flex;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
}

.dm-avatar--blue { background: linear-gradient(145deg, #5fb2dd, #3b8fbd); }
.dm-avatar--orange { background: linear-gradient(145deg, #ff9b5e, #ef6a2e); }
.dm-avatar--teal { background: linear-gradient(145deg, #57b8a8, #2e8f80); }
.dm-avatar--green { background: linear-gradient(145deg, #57a86b, #2e7d4a); }
.dm-avatar--deep { background: linear-gradient(145deg, #0c6b50, #064a38); }

.dm-main {
  flex: 1;
  min-width: 0;
}

.dm-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dm-name {
  overflow: hidden;
  color: #18211d;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dm-tag {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e5f3e7;
  color: #32745a;
  font-size: 18rpx;
  font-weight: 800;
}

.dm-time {
  flex: 0 0 auto;
  margin-left: auto;
  color: #a7aba7;
  font-size: 22rpx;
  white-space: nowrap;
}

.dm-preview {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #7d817e;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dm-row--unread .dm-preview {
  color: #4c5550;
  font-weight: 600;
}

.dm-unread {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #ff4d36;
  color: #fff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 6rpx 12rpx rgba(255, 77, 54, 0.28);
}

.dm-end {
  display: block;
  margin-top: 24rpx;
  color: #b9bdb9;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  text-align: center;
}
