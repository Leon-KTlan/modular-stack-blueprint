.page-scroll { height: 100vh; }
.circles-page { padding-top: calc(env(safe-area-inset-top) + 92rpx); }

.page-title-row { display: flex; align-items: flex-start; justify-content: space-between; }
.page-title { display: block; color: var(--forest); font-size: 54rpx; font-weight: 900; letter-spacing: -4rpx; }
.title-spark { margin-left: 8rpx; color: var(--orange); font-style: italic; }
.page-subtitle { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; }
.circle-search { width: 72rpx; height: 72rpx; border: 1rpx solid var(--line); border-radius: 50%; background: #fff; font-size: 42rpx; line-height: 68rpx; }

.circle-hero {
  position: relative;
  height: 214rpx;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #5ab9ef, #a4ddf7);
  color: #fff;
  box-shadow: 0 18rpx 40rpx rgba(71, 155, 200, 0.22);
}
.circle-hero__title { position: relative; z-index: 2; display: block; font-size: 38rpx; font-weight: 900; line-height: 1.25; transform: rotate(-3deg); }
.circle-hero__stroke { position: relative; z-index: 2; display: block; margin-top: 8rpx; color: #fff288; font-size: 24rpx; letter-spacing: 6rpx; }
.circle-hero__sun { position: absolute; z-index: 2; right: 54rpx; top: 28rpx; color: #fff168; font-size: 62rpx; }
.circle-hero__campus { position: absolute; left: 0; right: 0; bottom: 0; height: 58rpx; background: #f7e7c6; border-top: 12rpx solid rgba(255, 255, 255, 0.68); transform: skewY(-2deg); transform-origin: right; }

.filter-scroll { width: calc(100vw - 28rpx); margin-top: 24rpx; margin-right: -28rpx; }
.filter-row { display: inline-flex; gap: 14rpx; padding-right: 28rpx; }
.filter-pill { flex: 0 0 auto; min-width: 106rpx; padding: 15rpx 25rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.76); color: var(--muted); font-size: 23rpx; text-align: center; }
.filter-pill.is-active { background: var(--orange); color: #fff; font-weight: 800; box-shadow: 0 10rpx 22rpx rgba(255, 100, 30, 0.2); }
.filter-pill--pressed { opacity: 0.72; }

.joined-scroll { width: calc(100vw - 28rpx); margin-right: -28rpx; }
.joined-row { display: inline-flex; gap: 24rpx; padding-right: 28rpx; }
.joined-circle { width: 126rpx; text-align: center; }
.circle-icon { width: 112rpx; height: 112rpx; margin: 0 auto; border: 7rpx solid #fff; border-radius: 50%; box-shadow: 0 10rpx 26rpx rgba(38, 62, 50, 0.14); color: #fff; font-size: 38rpx; font-weight: 900; line-height: 98rpx; }
.circle-icon--green, .circle-art--green { background: linear-gradient(145deg, #6dbd7c, #267657); }
.circle-icon--yellow, .circle-art--yellow { background: linear-gradient(145deg, #f8c855, #e78b2d); }
.circle-icon--blue, .circle-art--blue { background: linear-gradient(145deg, #67b9f0, #356bd0); }
.circle-icon--orange, .circle-art--orange { background: linear-gradient(145deg, #ff9d4d, #ef5c21); }
.joined-circle__name { display: block; margin-top: 10rpx; font-size: 23rpx; font-weight: 800; white-space: nowrap; }
.joined-circle__count { display: block; margin-top: 3rpx; color: var(--muted); font-size: 18rpx; }

.circle-list { display: flex; flex-direction: column; gap: 16rpx; }
.circle-row { display: flex; align-items: center; min-height: 154rpx; padding: 20rpx; }
.circle-art { position: relative; flex: 0 0 108rpx; width: 108rpx; height: 108rpx; overflow: hidden; border-radius: 24rpx; color: #fff; font-size: 40rpx; font-weight: 900; line-height: 108rpx; text-align: center; }
.circle-art__dot { position: absolute; right: -12rpx; top: -18rpx; width: 54rpx; height: 54rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.3); }
.circle-row__body { flex: 1; min-width: 0; margin-left: 18rpx; }
.circle-row__title-line { display: flex; align-items: center; gap: 10rpx; }
.circle-row__title { font-size: 28rpx; font-weight: 900; }
.new-tag { padding: 4rpx 9rpx; border-radius: 999rpx; background: #e5f4ff; color: #3477bd; font-size: 17rpx; font-weight: 800; }
.circle-row__description { display: block; margin-top: 8rpx; color: #555b57; font-size: 22rpx; }
.circle-row__count { display: block; margin-top: 6rpx; color: var(--muted); font-size: 18rpx; }
.join-button { flex: 0 0 104rpx; width: 104rpx; height: 58rpx; border-radius: 999rpx; background: var(--orange); color: #fff; font-size: 22rpx; font-weight: 800; line-height: 58rpx; }
.join-button.is-joined { background: #f0eee9; color: #858782; }
